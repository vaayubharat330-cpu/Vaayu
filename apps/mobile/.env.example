# -----------------------------------------------------------------------------
# VAAYU Mobile Application Environment Configuration (.env.example)
# -----------------------------------------------------------------------------
# These variables can be supplied at compile time via Flutter's --dart-define
# or using a dart-define environment file:
#   flutter run --dart-define-from-file=.env
#
# IMPORTANT:
# In Release Mode (kReleaseMode), VAAYU fails closed if VAAYU_ENV is development
# or if non-TLS (http:// or ws://) endpoints are configured.
# -----------------------------------------------------------------------------

# Environment Target: development | staging | production
VAAYU_ENV=development

# Backend REST API Base URL
# Development emulator (Android loopback): http://10.0.2.2:4000
# Physical device on local WiFi: http://<YOUR_LOCAL_IP>:4000
# Production: https://api.vaayu.in
VAAYU_API_BASE_URL=http://10.0.2.2:4000

# Backend Real-time WebSocket Gateway URL
# Development emulator: ws://10.0.2.2:4000/ws
# Physical device on local WiFi: ws://<YOUR_LOCAL_IP>:4000/ws
# Production: wss://api.vaayu.in/ws
VAAYU_WS_BASE_URL=ws://10.0.2.2:4000/ws

# Diagnostics & Observability
# Enables in-app scenario runner, multi-role simulator shell, and debug overlays.
# Note: Always false in production release builds.
VAAYU_ENABLE_DIAGNOSTICS=true

# Verbose Network Traffic Logging
VAAYU_LOG_NETWORK_TRAFFIC=false
