# ---------------------------------------------------------------------------
# VAAYU backend configuration template.
# Copy to .env and fill in real values. Never commit .env.
# Development defaults are shown; production values are listed in DEPLOYMENT.md.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Persistence. Production must use postgres (PERSISTENCE_PROVIDER=postgres and DATABASE_URL).
# Values: json (development only), sqlite (local development), postgres (staging and production).
PERSISTENCE_PROVIDER=sqlite
DATABASE_PATH=./local-data/vaayu-dev.sqlite
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/vaayu
# Optional PostgreSQL settings. DATABASE_URL takes precedence over the PG* values.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=vaayu
# PGUSER=
# PGPASSWORD=
# PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=true
# PGPOOL_MAX=10
# PGCONNECT_TIMEOUT_MS=5000
# VAAYU_DATA_FILE=  (json store path, development only)

# Set TRUST_PROXY=true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Redis-backed rate limiting and locks. Required in production; the server refuses to start without it.
# REDIS_URL=redis://:PASSWORD@HOST:6379
# Development only: REDIS_HOST, REDIS_PORT, and ENABLE_DEV_REDIS=true to use a local Redis without REDIS_URL.
# REDIS_PROVIDER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# ENABLE_DEV_REDIS=false

# Secrets: generate separate random values (at least 32 characters) per environment.
JWT_SECRET=
OTP_HASH_SECRET=

# OTP delivery. Production fails closed without a signed HTTPS webhook.
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_SECRET=
# Production only, and only with explicit awareness: shows login codes to ADMIN on /otp-console.html.
# VAAYU_OTP_CONSOLE=false

# Admin accounts (JSON array). Use unique, high-entropy passwords. Never commit real values.
VAAYU_ADMIN_USERS_JSON=[]

# Exact portal origins, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:4000

# Map routing and geocoding. Point these at self-hosted or paid services in production.
# Defaults are public demo servers with no service guarantee; do not rely on them in production.
# OSRM_BASE_URL=https://router.example.com
# PHOTON_BASE_URL=https://photon.example.com
# NOMINATIM_BASE_URL=https://nominatim.example.com
# GOOGLE_MAPS_API_KEY=  (optional alternative routing provider)

# Process and logging.
# LOG_LEVEL=INFO
# NODE_ID=node_main
# WEB_CONCURRENCY=4
# ENABLE_CLUSTER=false  (not safe yet: in-memory state is per process)

# Development only. Must stay false or unset in production. Enables /api/trips/reset-test for SUPER_ADMIN.
# Login codes are never returned in responses. Use /otp-console.html in development.
ENABLE_TEST_ENDPOINTS=false
# Development only: relaxed rate limits for QA runs. Ignored in production.
# VAAYU_QA_RATE_LIMIT_DEFAULT=
# VAAYU_QA_RATE_LIMIT_OTP_SEND=

# Development only: shows OTP details in development responses. Never set in production.
# VAAYU_EXPOSE_DEV_OTP=false

# Payments stay off. Wallet top-up returns 503 until enabled deliberately.
RAZORPAY_ENABLED=false
VAAYU_ENABLE_RAZORPAYX_PAYOUTS=false

# Optional integrations (leave empty until configured).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Messaging webhook contract: signed JSON event with X-Vaayu-Timestamp,
# X-Vaayu-Signature (HMAC-SHA256 over timestamp + '.' + raw body), and Idempotency-Key.
MESSAGING_PROVIDER_WEBHOOK_URL=
MESSAGING_PROVIDER_WEBHOOK_SECRET=
