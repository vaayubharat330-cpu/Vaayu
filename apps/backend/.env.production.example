# ---------------------------------------------------------------------------
# VAAYU Production Environment Template (.env.production.example)
# Copy to .env in your production environment and provide hardened credentials.
# Strictly never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# 1. High-Performance Persistence (Managed PostgreSQL)
PERSISTENCE_PROVIDER=postgres
DATABASE_URL=postgresql://vaayu_app_limited:CHANGE_TO_COMPLEX_PASSWORD@127.0.0.1:5432/vaayu
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=20
PGCONNECT_TIMEOUT_MS=5000

# 2. Redis-Backed Distributed Rate Limiting & Mutex Locks
REDIS_URL=redis://:CHANGE_TO_STRONG_REDIS_PASSWORD@127.0.0.1:6379
REDIS_PROVIDER=redis
REDIS_CONNECT_TIMEOUT_MS=3000

# 3. Security Secrets (Minimum 64 characters high-entropy random strings)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_HEX_ENTROPY_KEY
OTP_HASH_SECRET=REPLACE_WITH_DEDICATED_MINIMUM_64_CHAR_HEX_KEY

# 4. SMS / WhatsApp OTP Webhook Delivery
OTP_DELIVERY_WEBHOOK_URL=https://sms-provider.internal.vaayu.in/v1/dispatch-otp
OTP_DELIVERY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
VAAYU_OTP_CONSOLE=false

# 5. Production Administrator Accounts (Strictly JSON formatted)
# Credentials must be kept in enterprise password managers.
VAAYU_ADMIN_USERS_JSON=[{"id":"adm_prod_1","username":"superadmin","password":"CHANGE_TO_COMPLEX_RANDOM_PASSWORD","role":"SUPER_ADMIN","name":"Lead Operations Officer"}]

# 6. CORS / Allowed Origins (Exact domains, comma-separated)
CORS_ALLOWED_ORIGINS=https://app.vaayu.in,https://driver.vaayu.in,https://merchant.vaayu.in,https://admin.vaayu.in

# 7. Reverse Proxy & Security Policy
TRUST_PROXY=true
ENABLE_TEST_ENDPOINTS=false
VAAYU_EXPOSE_DEV_OTP=false

# 8. External Routing & Telemetry Services (Self-hosted or managed)
OSRM_BASE_URL=http://127.0.0.1:5000
PHOTON_BASE_URL=http://127.0.0.1:2322

# 9. Third-Party Gateway Toggles (Kept off until formal launch)
RAZORPAY_ENABLED=false
VAAYU_ENABLE_RAZORPAYX_PAYOUTS=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
