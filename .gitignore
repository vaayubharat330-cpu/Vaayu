# Secrets. Never commit real values.
.env
.env.*
!.env.example
!.env.compose.example
apps/backend/.env
apps/backend/.env.*
!apps/backend/.env.example
!apps/backend/.env.production.example
apps/backend/secrets/

# Dependencies and local tools
node_modules/
apps/backend/node_modules/
apps/backend/.local-tools/

# Local data stores (development only). Production data lives in PostgreSQL.
apps/backend/local-data/
apps/backend/private_uploads/
apps/backend/src/db/*.sqlite
apps/backend/src/db/*.sqlite-shm
apps/backend/src/db/*.sqlite-wal
apps/backend/src/db/vaayu_store.json
apps/backend/src/db/vaayu_store.json.bak

# Build output
apps/backend/dist/

# Logs, scratch, and archives
*.log
*.out
*.err
scratch/
archive/
local-data/
backups/
apps/backend/backups/
